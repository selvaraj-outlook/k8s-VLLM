# Copy to backend.hcl and set your bucket, then:
#
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored because the bucket name is environment-specific.
# Create the bucket first: ./scripts/bootstrap-state.sh <bucket-name> <region>

bucket = "REPLACE-ME-k8s-vllm-tfstate"
key    = "k8s-vllm/infra.tfstate"
region = "us-east-1"

encrypt = true

# S3-native locking (Terraform 1.10+). No DynamoDB table required.
use_lockfile = true
